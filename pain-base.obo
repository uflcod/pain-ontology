property_value: skos:closeMatch SYMP:0000837
creation_date: 2022-11-24T06:02:26Z

[Term]
id: PAIN:0000041
name: nociceptive pain
def: "Pain that arises from actual or threatened damage to non-neural tissue and is due to the activation of nociceptors." [] {IAO:0000119="https://www.iasp-pain.org/resources/terminology/"}
is_a: PAIN:0000132 ! neurobiological pain process
intersection_of: PAIN:0000036 ! pain
intersection_of: RO:0002333 CL:0000198
intersection_of: RO:0002404 GO:0048265
property_value: IAO:0000589 "nociceptive pain (PAIN)" xsd:string
property_value: skos:closeMatch http://id.nlm.nih.gov/mesh/D059226
property_value: skos:closeMatch SYMP:0000831
property_value: skos:note "The term is used to describe pain occurring with a normally functioning somatosensory nervous system to contrast with the abnormal function seen in neuropathic or nociplasitic pain." xsd:string
property_value: terms:contributor https://orcid.org/0000-0001-9625-1899
property_value: terms:contributor https://orcid.org/0009-0003-5583-4731
property_value: terms:created "2024-06-13T18:47:03Z" xsd:dateTime

