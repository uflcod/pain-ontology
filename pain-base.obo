[Term]
id: PAIN:0000003
name: allodynia
def: "Pain due to a stimulus that does not normally provoke pain." [] {IAO:0000119="https://www.iasp-pain.org/resources/terminology"}
is_a: PAIN:0000036 ! pain
property_value: IAO:0000589 "allodynia (PAIN)" xsd:string
property_value: skos:closeMatch "http://purl.obolibrary.org/obo/HP_0012533" xsd:string
property_value: skos:closeMatch "http://purl.obolibrary.org/obo/NCIT_C180616" xsd:string
property_value: skos:closeMatch "http://purl.obolibrary.org/obo/SYMP_0000840" xsd:string
property_value: skos:closeMatch "http://purl.obolibrary.org/obo/UPHENO_7000639" xsd:string
property_value: skos:closeMatch "http://snomed.info/id/247404004" xsd:string
property_value: terms:contributor https://orcid.org/0000-0001-9625-1899
property_value: terms:created "2026-07-01T15:38:59Z" xsd:dateTime
property_value: terms:description "The stimulus leads to an unexpectedly painful response. This is a clinical term that does not imply a mechanism. Allodynia may be seen after different types of somatosensory stimuli applied to many different tissues.\nSee entry in https://www.iasp-pain.org/resources/terminology." xsd:string

