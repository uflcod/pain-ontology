[Typedef]
id: PAIN:0000061
name: experienced as
def: "A relation between a nervous system process and a cognitive process in which the nervous system process is gives rise to an experiential mental process." []
property_value: example_of_usage "Concomitant continuous pain (CCP) in trigeminal neuralgia is often experienced as burning or throbbing." xsd:string
property_value: terms:contributor https://orcid.org/0000-0001-9625-1899
property_value: terms:created "2024-06-13T22:09:02Z" xsd:dateTime
domain: GO:0050877
range: GO:0050890

[Typedef]
id: PAIN:0000062
name: experienced in
def: "A relation between a nervous system process and a cognitive process in which a physical sensation is subjectively experienced as occurring in an anatomical entity, site, or a site where an anatomical entity is usually located." []
property_value: example_of_usage "Brain freeze is a brief, intense pain experienced in the forehead." xsd:string
property_value: terms:contributor http://orcid.org/0000-0001-9625-1899
property_value: terms:created "2025-04-28T16:36:53Z" xsd:dateTime
domain: GO:0050877
range: GO:0050890

[Typedef]
id: PAIN:0000126
name: experienced in referred site
def: "A relation between a physical sensation and an anatomical entity or site, distinct from the site of the causal stimulus underlying the sensation, in which the sensation is subjectively experienced as occurring in the anatomical entity or site." []
property_value: example_of_usage "chest pain of myocardial infarction experienced in referred site left arm" xsd:string
property_value: example_of_usage "headache pain of a cold-stimulus response (brain freeze) experienced in referred site forehead" xsd:string
property_value: terms:contributor https://orcid.org/0000-0001-9625-1899
property_value: terms:created "2026-09-10T22:40:49Z" xsd:dateTime
is_a: PAIN:0000062 ! experienced in

