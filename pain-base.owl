        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000120"/>
        <obo:IAO_0000115>Mechanical pain that is elicited or intensified by active or passive movement of the affected body region.</obo:IAO_0000115>
        <obo:IAO_0000589>movement-evoked pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-02T01:44:08Z</terms:created>
        <rdfs:label xml:lang="en">movement-evoked pain</rdfs:label>
        <skos:closeMatch>http://snomed.info/id/425423002</skos:closeMatch>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000036"/>
        <obo:IAO_0000115>Pain resulting from osteoarthritis, a degenerative joint disease characterized by cartilage loss, subchondral bone changes, and joint inflammation.</obo:IAO_0000115>
        <obo:IAO_0000589>osteoarthritis pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-02T01:48:41Z</terms:created>
        <rdfs:label xml:lang="en">osteoarthritis pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000123">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PAIN_0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000061"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000058"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000129"/>
        <obo:IAO_0000115>Pain that is experienced as a rhythmic, pulsating, or beating sensation in which the pain&apos;s intensity waxes and wanes in periodic bursts. Throbbing pain is typically synchronized with the cardiac cycle.</obo:IAO_0000115>
        <obo:IAO_0000589>throbbing pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-08T19:58:42Z</terms:created>
        <rdfs:label xml:lang="en">throbbing pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/29695002"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000124 -->

