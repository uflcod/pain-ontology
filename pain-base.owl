        <rdfs:label xml:lang="en">damaged neural tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000044"/>
        <obo:IAO_0000115>Pain caused by a lesion or disease of the central somatosensory nervous system.</obo:IAO_0000115>
        <obo:IAO_0000589>central nervous system neuropathic pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
