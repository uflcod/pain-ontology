        <skos:closeMatch>http://snomed.info/id/410709000</skos:closeMatch>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000103">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PAIN_0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000061"/>
