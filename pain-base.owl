    <!-- http://purl.obolibrary.org/obo/PAIN_0000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000042"/>
        <obo:IAO_0000115>A constricting, gripping, or squeezing sensation quality. It is often associated with involuntary muscle contraction.</obo:IAO_0000115>
        <obo:IAO_0000589>cramping sensation quality (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
