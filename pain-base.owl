        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T16:57:37Z</terms:created>
        <rdfs:label xml:lang="en">cold pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000101 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000101">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/PAIN/0000036"/>
                    <owl:Restriction>
