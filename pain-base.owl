    <!-- http://purl.bioontology.org/ontology/PAIN/0000000 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000000">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/PAIN/0000090"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000062"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003700"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>Pain that is experienced in the temporomandibular joint.</obo:IAO_0000115>
        <obo:IAO_0000589>temporomandibular joint pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-17T13:10:32Z</terms:created>
        <oboInOwl:hasExactSynonym>TMJ pain</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">temporomandibular joint pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000001 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000001">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Persistent background pain that occurs alongside paroxysmal pain attacks, characteristic of conditions such as trigeminal neuralgia.</obo:IAO_0000115>
        <obo:IAO_0000589>concomitant continuous pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-08T16:42:44Z</terms:created>
        <rdfs:label xml:lang="en">concomitant continuous pain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Persistent background pain that occurs alongside paroxysmal pain attacks, characteristic of conditions such as trigeminal neuralgia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32791919</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.frontiersin.org/journals/neurology/articles/10.3389/fneur.2023.1277654/full</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000002 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000002">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000056"/>
        <obo:IAO_0000115>Pain that is experienced in the skin, muscles, joints, and bones.</obo:IAO_0000115>
        <obo:IAO_0000589>somatic pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-08T18:15:23Z</terms:created>
        <rdfs:label xml:lang="en">somatic pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/48429009"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain that is experienced in the skin, muscles, joints, and bones.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.verywellhealth.com/what-is-somatic-pain-2564619</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000003 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000003">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <obo:IAO_0000115>Pain due to a stimulus that does not normally provoke pain.</obo:IAO_0000115>
        <obo:IAO_0000589>allodynia (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T15:38:59Z</terms:created>
        <terms:description>The stimulus leads to an unexpectedly painful response. This is a clinical term that does not imply a mechanism. Allodynia may be seen after different types of somatosensory stimuli applied to many different tissues.
See entry in https://www.iasp-pain.org/resources/terminology.</terms:description>
        <rdfs:label xml:lang="en">allodynia</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/HP_0012533</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C180616</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000840</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/UPHENO_7000639</skos:closeMatch>
        <skos:closeMatch>http://snomed.info/id/247404004</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain due to a stimulus that does not normally provoke pain.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/terminology</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000004 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001457"/>
        <obo:IAO_0000115>A sensitivity of a process that characterizes a response to a painful stimulus.</obo:IAO_0000115>
        <obo:IAO_0000589>sensitivity to painful stimulus (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T23:13:11Z</terms:created>
        <rdfs:label xml:lang="en">sensitivity to painful stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000005 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000005">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000004"/>
        <obo:IAO_0000115>A sensitivity to painful stimulus which is lower than normal or average.</obo:IAO_0000115>
        <obo:IAO_0000589>decreased sensitivity to painful stimulus (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T23:19:07Z</terms:created>
        <rdfs:label xml:lang="en">decreased sensitivity to painful stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000006 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000006">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000117"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Increased pain from a stimulus that normally provokes pain.</obo:IAO_0000115>
        <obo:IAO_0000589>hyperalgesia (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T23:22:01Z</terms:created>
        <rdfs:label xml:lang="en">hyperalgesia</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MP_0005407</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000836</skos:closeMatch>
        <skos:closeMatch>http://snomed.info/id/55406008</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Increased pain from a stimulus that normally provokes pain.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/terminology</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000007 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000007">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <obo:IAO_0000115>Diminished pain in response to a normally painful stimulus.</obo:IAO_0000115>
        <obo:IAO_0000589>hypoalgesia (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T23:29:23Z</terms:created>
        <rdfs:label xml:lang="en">hypoalgesia</rdfs:label>
