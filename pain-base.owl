        <rdfs:comment>ICOP number: 1.1.2.1.1.3</rdfs:comment>
        <rdfs:label xml:lang="en">periodontal pain due to accidental dental injury</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010091"/>
        <rdfs:subClassOf>
