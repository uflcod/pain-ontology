        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 1.1.1.3.3.2</rdfs:comment>
        <rdfs:label xml:lang="en">pulpal pain due to irreversible pulpitis resulting from a dental hard-tissue fracture with pulp exposure</rdfs:label>
    </owl:Class>
    


