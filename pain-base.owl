        <skos:closeMatch rdf:resource="http://snomed.info/id/1259040000"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain caused by a lesion or disease of the central somatosensory nervous system.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/terminology/</obo:IAO_0000119>
