    <!-- http://purl.obolibrary.org/obo/PAIN_0000061 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PAIN_0000061">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/GO_0050877"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/GO_0050890"/>
        <obo:IAO_0000115>A relation between a nervous system process and a cognitive process in which the nervous system process is gives rise to an experiential mental process.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-13T22:09:02Z</terms:created>
        <rdfs:label xml:lang="en">experienced as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000062 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PAIN_0000062">
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-28T16:36:53Z</terms:created>
        <rdfs:label>A relation between a physical sensation and an anatomical entity or site where an anatomical entity is usually located in which the sensation is subjectively experienced as occurring in the anatomical entity or site.</rdfs:label>
        <rdfs:label xml:lang="en">experienced in</rdfs:label>
    </owl:ObjectProperty>
    


