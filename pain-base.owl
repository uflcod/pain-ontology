    <!-- http://purl.obolibrary.org/obo/PAIN_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000005"/>
        <obo:IAO_0000115>An abnormal sensory experience, whether spontaneous or evoked, that is not unpleasant.</obo:IAO_0000115>
        <obo:IAO_0000589>paresthesia (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T23:48:57Z</terms:created>
        <terms:description>Paresthesia be used to describe an abnormal sensation that is not unpleasant while dysesthesia be used preferentially for an abnormal sensation that is considered to be unpleasant. The use of one term (paresthesia) to indicate spontaneous sensations and the other to refer to evoked sensations is not favored. There is a sense in which, since paresthesia refers to abnormal sensations in general, it might include dysesthesia, but the reverse is not true. Dysesthesia does not include all abnormal sensations, but only those that are unpleasant.
See entry in https://www.iasp-pain.org/resources/terminology.</terms:description>
        <rdfs:label xml:lang="en">paresthesia</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D010292</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/HP_0003401</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C28177</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000435</skos:closeMatch>
        <skos:closeMatch>http://snomed.info/id/91019004</skos:closeMatch>
    </owl:Class>
    


