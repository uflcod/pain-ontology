            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Pulpal pain due to a dental procedure involving a recent placement of a direct or indirect dental restoration in the affected tooth.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-17T18:03:25Z</terms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 1.1.1.1.3.2</rdfs:comment>
        <rdfs:label xml:lang="en">pulpal pain due to placement of a restoration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0010107"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Pulpal pain caused by reversible pulpitis due to infection of dentin because of a crack or incomplete fracture of the affected tooth, involving the enamel or enamel and dentin. Has evidence of at least one of the following: sharp pain upon biting, pain on release of occlusal biting pressure or external application of force, and cold hypersensitivity.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-23T20:21:16Z</terms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 1.1.1.3.1.3</rdfs:comment>
        <rdfs:label xml:lang="en">pulpal pain due to reversible pulpitis resulting from tooth crack without evidence of missing tooth substance.</rdfs:label>
    </owl:Class>
    


