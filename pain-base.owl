    <!-- http://purl.bioontology.org/ontology/PAIN/0000047 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000047">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A sensation quality that characterizes a sensation as being persistent, deep, or nagging rather than a sharp or stabbing.</obo:IAO_0000115>
