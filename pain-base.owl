        <rdfs:comment>ICOP number: 1.1.2.1.2.1</rdfs:comment>
        <rdfs:label xml:lang="en">periodontal pain due to pulpal inflammation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010091"/>
