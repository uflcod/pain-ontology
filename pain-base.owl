        <obo:IAO_0000119>PMID:16675817</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000042"/>
        <obo:IAO_0000115>A prickling, pins-and-needles sensation quality, often with a fine, vibratory character.</obo:IAO_0000115>
        <obo:IAO_0000589>tingling sensation quality (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
