        <rdfs:label xml:lang="en">decreased sensitivity to painful stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000117">
