    <!-- http://purl.obolibrary.org/obo/PAIN_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000036"/>
        <obo:IAO_0000115>Pain that is provoked or worsened by mechanical loading, movement, or postural change.</obo:IAO_0000115>
        <obo:IAO_0000589>mechanical pain (PAIN)</obo:IAO_0000589>
