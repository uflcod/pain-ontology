    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010069"/>
        <rdfs:subClassOf>
            <owl:Restriction>
