    <!-- http://purl.obolibrary.org/obo/PAIN_0000061 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PAIN_0000061">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/GO_0050877"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/GO_0050890"/>
        <obo:IAO_0000112>Concomitant continuous pain (CCP) in trigeminal neuralgia is often experienced as burning or throbbing.</obo:IAO_0000112>
        <obo:IAO_0000115>A relation between a nervous system process and a cognitive process in which the nervous system process is gives rise to an experiential mental process.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-13T22:09:02Z</terms:created>
        <rdfs:label xml:lang="en">experienced as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000062 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PAIN_0000062">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/GO_0050877"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/GO_0050890"/>
        <obo:IAO_0000112>Brain freeze is a brief, intense pain experienced in the forehead.</obo:IAO_0000112>
        <obo:IAO_0000115>A relation between a nervous system process and a cognitive process in which a physical sensation is subjectively experienced as occurring in an anatomical entity, site, or a site where an anatomical entity is usually located.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-28T16:36:53Z</terms:created>
        <rdfs:label xml:lang="en">experienced in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000126 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PAIN_0000126">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000062"/>
        <obo:IAO_0000112>chest pain of myocardial infarction experienced in referred site left arm</obo:IAO_0000112>
        <obo:IAO_0000112>headache pain of a cold-stimulus response (brain freeze) experienced in referred site forehead</obo:IAO_0000112>
        <obo:IAO_0000115>A relation between a physical sensation and an anatomical entity or site, distinct from the site of the causal stimulus underlying the sensation, in which the sensation is subjectively experienced as occurring in the anatomical entity or site.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-09-10T22:40:49Z</terms:created>
        <rdfs:label xml:lang="en">experienced in referred site</rdfs:label>
    </owl:ObjectProperty>
    


