                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000129"/>
        <obo:IAO_0000115>Pain that is experienced as a result of cold stimuli at intensities below the freezing threshold.</obo:IAO_0000115>
        <obo:IAO_0000589>cold pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T16:57:37Z</terms:created>
        <rdfs:label xml:lang="en">cold pain</rdfs:label>
    </owl:Class>
    


