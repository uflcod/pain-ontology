        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 1.1.2.1.3.1</rdfs:comment>
        <rdfs:label xml:lang="en">periodontal pain due to chronic periodontitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010078"/>
