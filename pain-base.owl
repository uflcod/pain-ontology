        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Diminished pain in response to a normally painful stimulus.</owl:annotatedTarget>
