            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000129"/>
        <obo:IAO_0000115>Pain that is experienced as a constricting, gripping, or squeezing sensation. It is often associated with involuntary muscle contraction.</obo:IAO_0000115>
        <obo:IAO_0000589>cramping pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T17:39:15Z</terms:created>
