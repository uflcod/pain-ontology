    <!-- http://purl.obolibrary.org/obo/PAIN_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000042"/>
        <obo:IAO_0000115>A sensation quality that characterizes a sensation as being persistent, deep, or nagging rather than a sharp or stabbing.</obo:IAO_0000115>
        <obo:IAO_0000589>dull sensation quality (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:02:36Z</terms:created>
        <rdfs:label xml:lang="en">dull sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/410708008"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensation quality that characterizes a sensation as being persistent, deep, or nagging rather than a sharp or stabbing.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.healthline.com/health/dull-pain</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.merriam-webster.com/dictionary/dull</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000048 -->

