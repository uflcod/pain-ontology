    <!-- http://purl.obolibrary.org/obo/PAIN_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000036"/>
        <obo:IAO_0000115>Pain due to a stimulus that does not normally provoke pain.</obo:IAO_0000115>
        <obo:IAO_0000589>allodynia (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T15:38:59Z</terms:created>
        <terms:description>The stimulus leads to an unexpectedly painful response. This is a clinical term that does not imply a mechanism. Allodynia may be seen after different types of somatosensory stimuli applied to many different tissues.
See entry in https://www.iasp-pain.org/resources/terminology.</terms:description>
        <rdfs:label xml:lang="en">allodynia</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/HP_0012533</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C180616</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000840</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/UPHENO_7000639</skos:closeMatch>
        <skos:closeMatch>http://snomed.info/id/247404004</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain due to a stimulus that does not normally provoke pain.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/terminology</obo:IAO_0000119>
    </owl:Axiom>
    


