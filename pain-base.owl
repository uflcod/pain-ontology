    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain without known cause or of spontaneous origin.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41307755</obo:IAO_0000119>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Idiopathic_disease</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000038">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PAIN_0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002630"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000128"/>
        <obo:IAO_0000115>Acute transient pain that is severe and has an intensity that flares over baseline.</obo:IAO_0000115>
        <obo:IAO_0000589>episodic pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-08T17:10:12Z</terms:created>
        <oboInOwl:hasRelatedSynonym>breakthrough pain</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">episodic pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0032148"/>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C9203"/>
