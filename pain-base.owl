        <rdfs:label xml:lang="en">tingling sensation quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000040">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PAIN_0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001863"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000128"/>
        <obo:IAO_0000115>Pain that persists or recurs for longer than 3 months, in which each incidence of pain is attributed to the same underlying condition.</obo:IAO_0000115>
        <obo:IAO_0000589>chronic pain (PAIN)</obo:IAO_0000589>
        <dc:contributor>https://orcid.org/0000-0001-9625-1899</dc:contributor>
        <oboInOwl:creation_date>2022-11-24T06:02:26Z</oboInOwl:creation_date>
        <rdfs:comment>In many cases, the pain is initially caused by tissue damage or disease. The continuation of the pain is often the result of pathological changes in the central nervous system.</rdfs:comment>
        <rdfs:label xml:lang="en">chronic pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0012532"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26940"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000837"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000040"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain that persists or recurs for longer than 3 months, in which each incidence of pain is attributed to the same underlying condition.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/advocacy/definitions-of-chronic-pain-syndromes/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000041">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PAIN_0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002333"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000198"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0048265"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000132"/>
        <obo:IAO_0000115>Pain that arises from actual or threatened damage to non-neural tissue and is due to the activation of nociceptors.</obo:IAO_0000115>
        <obo:IAO_0000589>nociceptive pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-13T18:47:03Z</terms:created>
        <rdfs:label xml:lang="en">nociceptive pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://id.nlm.nih.gov/mesh/D059226"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000831"/>
        <skos:note>The term is used to describe pain occurring with a normally functioning somatosensory nervous system to contrast with the abnormal function seen in neuropathic or nociplasitic pain.</skos:note>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000041"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain that arises from actual or threatened damage to non-neural tissue and is due to the activation of nociceptors.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/terminology/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0000042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001236"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process quality that is the characteristic of a sensory experience.</obo:IAO_0000115>
        <obo:IAO_0000589>sensation quality (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:02:29Z</terms:created>
