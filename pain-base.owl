    <!-- http://purl.obolibrary.org/obo/PAIN_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000053">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PAIN_0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
