                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0010144"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>periodontal pain attributed to traumatically induced periodontal inflammation because of a change in occlusal conditions that has occurred, with resultant hyperarticulation identified by primary contact affecting a tooth in articulation or hypermobility of a tooth.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-26T18:26:45Z</terms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:label xml:lang="en">periodontal pain due to hyperarticulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010073"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0010148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Periodontal pain attributed to traumatically induced periodontal inflammation because of accidental trauma with evidence of one of the following: concussion, subluxation, lateral luxation, intrusion, extrusion, avulsion, or root fracture.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
