# Class: <http://purl.bioontology.org/ontology/PAIN/0000036> (pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000036> "An unpleasant sensory and emotional experience associated with, or resembling that associated with, actual or potential tissue damage.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000036> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000036> "2024-06-13T18:46:52Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.bioontology.org/ontology/PAIN/0000036> "Six key notes and etymology:

 - Pain is always a personal experience that is influenced to varying degrees by biological, psychological, and social factors.
 
- Pain and nociception are different phenomena. Pain cannot be inferred solely from activity in sensory neurons.

- Through their life experiences, individuals learn the concept of pain.
 
- A person’s report of an experience as pain should be respected.
 
- Although pain usually serves an adaptive role, it may have adverse effects on function and social and psychological well-being.

 - Verbal description is only one of several behaviors to express pain; inability to communicate does not negate the possibility that a human or a nonhuman animal experiences pain.")
AnnotationAssertion(rdfs:comment <http://purl.bioontology.org/ontology/PAIN/0000036> "The \"emotional\" part of pain captures the affective (i.e., unpleasant) dimension of experiencing pain.")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000036> "pain"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.bioontology.org/ontology/PAIN/0000036> "- The Revised IASP definition of pain: concepts, challenges, and compromises. 
https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7680716/

- Merskey H, Albe-Fessard DG, Bonica JJ, et al: Pain terms: A list with definitions and notes on usage. Recommended by the IASP Subcommittee on Taxonomy. Pain 1979; 6:249-252. http://www.iasp-pain.org/source/eforums.")
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000036> <http://purl.bioontology.org/ontology/EMRO/0000005>)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.bioontology.org/ontology/EMRO/0000000>))
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002404> <http://purl.obolibrary.org/obo/GO_0019233>))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000037> (idiopathic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dictionary.apa.org/idiopathic") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000037> "Pain without known cause or of spontaneous origin.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000037> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000037> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000037> "2026-04-08T17:09:41Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000037> "idiopathic pain")
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000037> <http://purl.bioontology.org/ontology/PAIN/0000036>)

# Class: <http://purl.bioontology.org/ontology/PAIN/0000038> (episodic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16675817") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000038> "Acute transient pain that is severe and has an intensity that flares over baseline.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000038> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000038> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000038> "2026-04-08T17:10:12Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.bioontology.org/ontology/PAIN/0000038> "breakthrough pain")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000038> "episodic pain")
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000038> <http://purl.bioontology.org/ontology/PAIN/0000036>)

# Class: <http://purl.bioontology.org/ontology/PAIN/0000040> (chronic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31971706") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dictionary.apa.org/chronic-pain") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/advocacy/definitions-of-chronic-pain-syndromes/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000040> "Pain that persists or recurs over an extended period of time in which each incidence of pain is attributed to the same underlying condition.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.bioontology.org/ontology/PAIN/0000040> "https://orcid.org/0000-0001-9625-1899")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.bioontology.org/ontology/PAIN/0000040> "2022-11-24T06:02:26Z")
AnnotationAssertion(rdfs:comment <http://purl.bioontology.org/ontology/PAIN/0000040> "In many cases, the pain is initially caused by tissue damage or disease. The continuation of the pain is often the result of pathological changes in the central nervous system.")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000040> "chronic pain"@en)
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000040> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0001863>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000041> (nociceptive pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000041> "Pain that arises from actual or threatened damage to non-neural tissue and is due to the activation of nociceptors.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000041> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000041> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000041> "2024-06-13T18:47:03Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000041> "nociceptive pain"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#note> <http://purl.bioontology.org/ontology/PAIN/0000041> "The term is used to describe pain occurring with a normally functioning somatosensory nervous system to contrast with the abnormal function seen in neuropathic or nociplasitic pain.")
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000041> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002333> <http://purl.obolibrary.org/obo/CL_0000198>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002404> <http://purl.obolibrary.org/obo/GO_0048265>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000042> (sensation quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000042> "A process quality that is the characteristic of a sensory experience.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000042> <http://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000042> "2025-05-12T17:02:29Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000042> "sensation quality"@en)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000042> <http://purl.obolibrary.org/obo/PATO_0001236>)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000042> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.bioontology.org/ontology/EMRO/0000005>))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000043> (nociplastic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000043> "Pain that arises from altered nociception despite no clear evidence of actual or threatened tissue damage causing the activation of peripheral nociceptors or evidence for disease or lesion of the somatosensory system causing the pain.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000043> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000043> "2024-06-13T18:47:11Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000043> "nociplastic pain"@en)
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000043> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/GO_0046960>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000044> (neuropathic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000044> "Pain caused by a lesion or disease of the somatosensory nervous system.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000044> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000044> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000044> "2024-06-13T18:47:32Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000044> "neuropathic pain"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#note> <http://purl.bioontology.org/ontology/PAIN/0000044> "Neuropathic pain is a clinical description (and not a diagnosis) which requires a demonstrable lesion or a disease that satisfies established neurological diagnostic criteria. The term lesion is commonly used when diagnostic investigations (e.g. imaging, neurophysiology, biopsies, lab tests) reveal an abnormality or when there was obvious trauma.")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#note> <http://purl.bioontology.org/ontology/PAIN/0000044> "Somatosensory refers to information about the body per se including visceral organs, rather than information about the external world (e.g., vision, hearing, or olfaction). The presence of symptoms or signs (e.g., touch-evoked pain) alone does not justify the use of the term neuropathic. Some disease entities, such as trigeminal neuralgia, are currently defined by their clinical presentation rather than by objective diagnostic testing. Other diagnoses such as postherpetic neuralgia are normally based upon the history. It is common when investigating neuropathic pain that diagnostic testing may yield inconclusive or even inconsistent data. In such instances, clinical judgment is required to reduce the totality of findings in a patient into one putative diagnosis or concise group of diagnoses.")
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000044> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002410> <http://purl.bioontology.org/ontology/PAIN/0000045>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000045> (damaged neural tissue)

AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000045> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000045> "2024-06-13T20:45:30Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000045> "damaged neural tissue"@en)
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000045> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0003714> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0001167>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000046> (central nervous system neuropathic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000046> "Pain caused by a lesion or disease of the central somatosensory nervous system.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000046> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000046> "2024-06-13T21:22:21Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000046> "central nervous system neuropathic pain"@en)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000046> <http://purl.bioontology.org/ontology/PAIN/0000044>)

# Class: <http://purl.bioontology.org/ontology/PAIN/0000047> (dull sensation quality)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.healthline.com/health/dull-pain") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.merriam-webster.com/dictionary/dull") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000047> "A sensation quality that characterizes a sensation as being persistent, deep, or nagging rather than a sharp or stabbing.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000047> <http://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000047> "2025-05-12T17:02:36Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000047> "dull sensation quality"@en)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000047> <http://purl.bioontology.org/ontology/PAIN/0000042>)

# Class: <http://purl.bioontology.org/ontology/PAIN/0000052> (peripheral nervous system neuropathic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000052> "Pain caused by a lesion or disease of the peripheral somatosensory nervous system.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000052> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000052> "2024-06-13T21:22:44Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000052> "peripheral nervous system neuropathic pain"@en)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000052> <http://purl.bioontology.org/ontology/PAIN/0000044>)

# Class: <http://purl.bioontology.org/ontology/PAIN/0000053> (acute pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/topics/acute-pain/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000053> "Pain that happens suddenly, starts out sharp or intense, and serves as a warning sign of disease or threat to the body.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.bioontology.org/ontology/PAIN/0000053> "https://orcid.org/0000-0001-9625-1899")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.bioontology.org/ontology/PAIN/0000053> "2022-11-24T06:02:26Z")
AnnotationAssertion(rdfs:comment <http://purl.bioontology.org/ontology/PAIN/0000053> "Acute pain is caused by injury, surgery, illness, trauma, or painful medical procedures and generally lasts from a few minutes to less than six months. Acute pain usually disappears whenever the underlying cause is treated or healed.")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000053> "acute pain"@en)
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000053> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0000389>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000054> (referred pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37448749") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dictionary.apa.org/referred-sensation") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000054> "Pain that is experienced in an area different from the area stimulated.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000054> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000054> "2024-06-13T21:22:52Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000054> "referred pain"@en)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000054> <http://purl.bioontology.org/ontology/PAIN/0000036>)

