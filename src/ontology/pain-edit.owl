AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010247> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010247> "ICOP number: 4.1.1.2.2")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010247> "trigeminal neuralgia due to space-occupying lesion"@en)
