AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.healthline.com/health/dull-pain") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000073> "Pain that is experienced as a deep ache, pressure, or heaviness rather than a sharp, stabbing sensation.")
