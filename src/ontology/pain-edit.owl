# Class: <http://purl.obolibrary.org/obo/PAIN_0010299> (trigeminal neuropathic pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010299> "Orofacial pain in the distribution of one or more branches of the trigeminal nerve. The primary pain is usually continuous or near-continuous, and commonly described as burning, squeezing, aching or likened to pins and needles.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010299> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010299> <https://orcid.org/0009-0002-7282-0836>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010299> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010299> "2025-07-08T17:40:50Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PAIN_0010299> "trigeminal neuropathic pain attributed to other disorder")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010299> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010299> "ICOP number: 4.1.2")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010299> "Superimposed brief pain paroxysms may occur but these are not the predominant pain type. This combination is distinct from that of 4.1.1 Trigeminal neuralgia. There are clinically detectable somatosensory changes within the trigeminal distribution, and mechanical allodynia and cold hyperalgesia/allodynia are common, fulfilling the IASP criteria for neuropathic pain. Allodynic areas may be much larger than the punctate trigger zones present in 4.1.1 Trigeminal neuralgia.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010299> "related ICOP number: 4.1.2.4")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010299> "trigeminal neuropathic pain"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010299> <http://purl.obolibrary.org/obo/PAIN_0010059>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010300> (trigeminal neuropathic pain attributed to herpes zoster)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010300> "Unilateral facial pain of less than 3 months’ duration in the distribution of one or more branches of the trigeminal nerve, caused by, and associated with other symptoms and/or clinical signs of, acute herpes zoster.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010300> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010300> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010300> "2025-07-08T17:41:58Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010300> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010300> "ICOP number: 4.1.2.1")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010300> "trigeminal neuropathic pain attributed to herpes zoster"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010300> <http://purl.obolibrary.org/obo/PAIN_0010299>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010301> (trigeminal postherpetic neuralgia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010301> "Unilateral facial pain persisting or recurring for at least 3 months in the distribution(s) of one or more branches of the trigeminal nerve, with variable sensory changes, caused by herpes zoster.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010301> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010301> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010301> "2025-07-08T17:42:37Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010301> <http://purl.obolibrary.org/obo/PAIN_0010296>)
