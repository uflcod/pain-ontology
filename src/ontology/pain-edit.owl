AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010256> "Episodic or chronic pain exclusively in the orofacial region, without head pain, with the characteristics and associated features of 1. Migraine described in ICHD-3.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010256> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010256> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010256> "2025-07-02T19:32:24Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010256> <http://purl.obolibrary.org/obo/PAIN_0010296>)
