# Class: <http://purl.obolibrary.org/obo/PAIN_0010271> (hemifacial continuous pain with autonomic symptoms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010271> "While no isolated facial equivalent of 3.4 Hemicrania continua, described in International Classification of Headache Disorders 3rd Edition,, has so far been clearly established, extension of pain into the face in hemicrania continua has been described. Thus, pain referral and/or radiation to oral and/or facial structures may cause diagnostic difficulties.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010271> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010271> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010271> "2025-07-07T17:27:44Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010271> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010271> "ICOP number: 5.3.4")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010271> "hemifacial continuous pain with autonomic symptoms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010271> <http://purl.obolibrary.org/obo/PAIN_0010260>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010272> (neurovascular orofacial pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010272> "Attacks of variable duration of moderate or severe intraoral pain, without head pain, often accompanied by toothache-like symptoms, with mild autonomic and/or migrainous symptoms. Two subforms are represented by patients with relatively short attacks (1–4 hours) and those with longer attacks (>4 hours).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010272> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010272> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010272> "2025-07-07T17:28:50Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010272> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010272> "ICOP number: 5.4")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010272> "neurovascular orofacial pain"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010272> <http://purl.obolibrary.org/obo/PAIN_0010255>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010273> (short-lasting neurovascular orofacial pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010273> "Neurovascular orofacial pain that lasts between 1-4 hours.")
