# Class: <http://purl.obolibrary.org/obo/PAIN_0010233> (myofascial orofacial pain attributed to tendonitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010233> "Pain of tendon origin, affected by jaw movement, function or parafunction and replicated by provocation-testing of the relevant masticatory tendon. Limitation of mandibular movement(s) secondary to pain may be present. The temporalis tendon is a common site of tendonitis and may refer pain to the teeth and other nearby structures. Tendonitis can also occur in other masticatory muscle tendons.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010233> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010233> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010233> "2025-07-01T17:46:19Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010233> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010233> "ICOP number: 2.2.1")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010233> "myofascial orofacial pain attributed to tendonitis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010233> <http://purl.obolibrary.org/obo/PAIN_0010232>)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010233> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002410> <http://purl.obolibrary.org/obo/OHD_0010291>))

# Class: <http://purl.obolibrary.org/obo/PAIN_0010234> (myofascial orofacial pain attributed to myositis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010234> "Pain caused by myositis affecting one or more masticatory muscles, with clinical characteristics of inﬂammation or infection: oedema, erythema and/or increased temperature. It generally arises acutely following direct trauma of the muscle or from infection, or chronically with autoimmune disease. Limitation of unassisted mandibular movements secondary to pain is often present. Calciﬁcation of the muscle can occur (i.e. myositis ossiﬁcans).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010234> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010234> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010234> "2025-07-01T17:48:14Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010234> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010234> "ICOP number: 2.2.2")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010234> "myofascial orofacial pain attributed to myositis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010234> <http://purl.obolibrary.org/obo/PAIN_0010232>)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010234> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002410> <http://purl.obolibrary.org/obo/OHD_0010305>))

# Class: <http://purl.obolibrary.org/obo/PAIN_0010235> (myofascial orofacial pain attributed to muscle spasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010235> "Pain caused by sudden, involuntary, reversible tonic contraction of a muscle. Such spasm may affect any of the masticatory muscles. Acute malocclusion may be present.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010235> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010235> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010235> "2025-07-01T17:49:34Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010235> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010235> "ICOP number: 2.2.3")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010235> "myofascial orofacial pain attributed to muscle spasm"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010235> <http://purl.obolibrary.org/obo/PAIN_0010232>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010236> (temporomandibular joint pain attributed to arthritis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010236> "TMJ pain caused by persistent inflammation of articular tissues (due, for example, to trauma, infection, crystal deposition or autoimmune disorder). TMJ pain is common in TMJ arthritis, but TMJ arthritis can be present without pain.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010236> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010236> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010236> "2025-07-01T17:52:37Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010236> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010236> "ICOP number: 3.2.1")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010236> "temporomandibular joint pain attributed to arthritis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010236> <http://purl.obolibrary.org/obo/PAIN_0010128>)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010236> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002410> <http://purl.obolibrary.org/obo/OHD_0010306>))

