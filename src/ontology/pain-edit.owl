############################
#   Object Properties
############################

# Object Property: <http://purl.bioontology.org/ontology/PAIN/0000061> (experienced as)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.bioontology.org/ontology/PAIN/0000061> "Concomitant continuous pain (CCP) in trigeminal neuralgia is often experienced as burning or throbbing.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000061> "A relation between a nervous system process and a cognitive process in which the nervous system process is gives rise to an experiential mental process.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000061> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000061> "2024-06-13T22:09:02Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000061> "experienced as"@en)
ObjectPropertyDomain(<http://purl.bioontology.org/ontology/PAIN/0000061> <http://purl.obolibrary.org/obo/GO_0050877>)
ObjectPropertyRange(<http://purl.bioontology.org/ontology/PAIN/0000061> <http://purl.obolibrary.org/obo/GO_0050890>)

# Object Property: <http://purl.bioontology.org/ontology/PAIN/0000062> (A relation between a physical sensation and an anatomical entity or site where an anatomical entity is usually located in which the sensation is subjectively experienced as occurring in the anatomical entity or site.)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.bioontology.org/ontology/PAIN/0000062> "Brain freeze is a brief, intense pain experienced in the forehead.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000062> <http://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000062> "2025-04-28T16:36:53Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000062> "A relation between a physical sensation and an anatomical entity or site where an anatomical entity is usually located in which the sensation is subjectively experienced as occurring in the anatomical entity or site.")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000062> "experienced in"@en)



############################
#   Classes
############################

# Class: <http://purl.bioontology.org/ontology/0000049> (throbbing pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/0000049> "Pain that is experienced as a rhythmic, pulsating, or beating sensation in which the pain's intensity waxes and wanes in periodic bursts. Throbbing pain is typically synchronized with the cardiac cycle.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000589> <http://purl.bioontology.org/ontology/0000049> "throbbing pain (PAIN)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/0000049> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/0000049> "2026-04-08T19:58:42Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/0000049> "throbbing pain")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.bioontology.org/ontology/0000049> <http://snomed.info/id/29695002>)
EquivalentClasses(<http://purl.bioontology.org/ontology/0000049> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000036> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.bioontology.org/ontology/PAIN/0000058>)))

# Class: <http://purl.bioontology.org/ontology/0000050> (chronic high impact pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/fact-sheets/high-impact-chronic-pain/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/0000050> "Chronic pain that frequently limits life or work activities.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000589> <http://purl.bioontology.org/ontology/0000050> "chronic high impact (PAIN)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/0000050> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/0000050> "2026-05-01T20:50:40Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/0000050> "chronic high impact pain")
SubClassOf(<http://purl.bioontology.org/ontology/0000050> <http://purl.bioontology.org/ontology/PAIN/0000040>)

# Class: <http://purl.bioontology.org/ontology/PAIN/0000000> (temporomandibular joint pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000000> "Pain that is experienced in the temporomandibular joint.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000589> <http://purl.bioontology.org/ontology/PAIN/0000000> "temporomandibular joint pain (PAIN)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000000> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000000> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000000> "2026-03-17T13:10:32Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.bioontology.org/ontology/PAIN/0000000> "TMJ pain")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000000> "temporomandibular joint pain")
EquivalentClasses(<http://purl.bioontology.org/ontology/PAIN/0000000> ObjectIntersectionOf(<http://purl.bioontology.org/ontology/PAIN/0000090> ObjectSomeValuesFrom(<http://purl.bioontology.org/ontology/PAIN/0000062> <http://purl.obolibrary.org/obo/UBERON_0003700>)))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000001> (concomitant continuous pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32791919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.frontiersin.org/journals/neurology/articles/10.3389/fneur.2023.1277654/full") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000001> "Persistent background pain that occurs alongside paroxysmal pain attacks, characteristic of conditions such as trigeminal neuralgia.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000589> <http://purl.bioontology.org/ontology/PAIN/0000001> "concomitant continuous pain (PAIN)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000001> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000001> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000001> "2026-04-08T16:42:44Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000001> "concomitant continuous pain")
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000001> <http://purl.bioontology.org/ontology/PAIN/0000040>)
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0000689>))

# Class: <http://purl.bioontology.org/ontology/PAIN/0000002> (somatic pain)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.verywellhealth.com/what-is-somatic-pain-2564619") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000002> "Pain that is experienced in the skin, muscles, joints, and bones.")
