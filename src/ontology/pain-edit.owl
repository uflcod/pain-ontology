ObjectPropertyRange(<http://purl.obolibrary.org/obo/PAIN_0000062> <http://purl.obolibrary.org/obo/GO_0050890>)

# Object Property: <http://purl.obolibrary.org/obo/PAIN_0000126> (experienced in referred site)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/PAIN_0000126> "chest pain of myocardial infarction experienced in referred site left arm")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/PAIN_0000126> "headache pain of a cold-stimulus response (brain freeze) experienced in referred site forehead")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0000126> "A relation between a physical sensation and an anatomical entity or site, distinct from the site of the causal stimulus underlying the sensation, in which the sensation is subjectively experienced as occurring in the anatomical entity or site.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0000126> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0000126> "2026-09-10T22:40:49Z"^^xsd:dateTime)
