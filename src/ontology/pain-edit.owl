# Class: <http://purl.bioontology.org/ontology/PAIN/0000104> (dysesthesia)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.iasp-pain.org/resources/terminology") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000104> "An unpleasant abnormal sensory experience, whether spontaneous or evoked.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000589> <http://purl.bioontology.org/ontology/PAIN/0000104> "dysesthesia (PAIN)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000104> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000104> "2026-07-01T17:55:31Z"^^xsd:dateTime)
AnnotationAssertion(<http://purl.org/dc/terms/description> <http://purl.bioontology.org/ontology/PAIN/0000104> "An unpleasant abnormal sensation, whether spontaneous or evoked. Note: Compare with pain and with paresthesia. Special cases of dysesthesia include hyperalgesia and allodynia. A dysesthesia should always be unpleasant and a paresthesia should not be unpleasant, although it is recognized that the borderline may present some difficulties when it comes to deciding as to whether a sensation is pleasant or unpleasant. It should always be specified whether the sensations are spontaneous or evoked.
See entry in https://www.iasp-pain.org/resources/terminology.")
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/PAIN/0000104> "dysesthesia")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.bioontology.org/ontology/PAIN/0000104> "http://purl.obolibrary.org/obo/NCIT_C28246")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.bioontology.org/ontology/PAIN/0000104> "http://snomed.info/id/279079003")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.bioontology.org/ontology/PAIN/0000104> "http://purl.obolibrary.org/obo/HP_0012534")
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000104> <http://purl.bioontology.org/ontology/EMRO/0000005>)

