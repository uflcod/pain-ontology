AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010262> "ICOP number: 5.3.1.1")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010262> "episodic orofacial cluster attacks"@en)
