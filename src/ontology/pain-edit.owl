AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010302> "post-traumatic trigeminal neuropathic pain"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010302> <http://purl.obolibrary.org/obo/PAIN_0010299>)

