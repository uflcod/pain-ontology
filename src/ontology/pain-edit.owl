# Class: <http://purl.bioontology.org/ontology/PAIN/0000021> (paroxysmal pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.bioontology.org/ontology/PAIN/0000021> "Pain occurring as sudden, brief, recurrent attacks. It is often severe in intensity.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000589> <http://purl.bioontology.org/ontology/PAIN/0000021> "paroxysmal pain (PAIN)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.bioontology.org/ontology/PAIN/0000021> <https://orcid.org/0000-0001-9625-1899>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.bioontology.org/ontology/PAIN/0000021> "2026-07-01T23:58:46Z"^^xsd:dateTime)
