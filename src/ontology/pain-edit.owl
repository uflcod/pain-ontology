AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.bioontology.org/ontology/PAIN/0000003> "http://purl.obolibrary.org/obo/UPHENO_7000639")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.bioontology.org/ontology/PAIN/0000003> "http://snomed.info/id/247404004")
SubClassOf(<http://purl.bioontology.org/ontology/PAIN/0000003> <http://purl.bioontology.org/ontology/PAIN/0000036>)

