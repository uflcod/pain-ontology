AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010237> "temporomandibular joint pain attributed to non-systemic arthritis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010237> <http://purl.obolibrary.org/obo/PAIN_0010236>)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010237> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002410> <http://purl.obolibrary.org/obo/OHD_0010307>))

# Class: <http://purl.obolibrary.org/obo/PAIN_0010238> (temporomandibular joint pain attributed to systemic arthritis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010238> "Temporomandibular joint due to arthritis with evidence of systemic inflammatory joint disease, pain developed in close temporal relation to other symptoms, and either the pain has significantly worsened in parallel with worsening of the systemic inflammatory joint disease or the pain has significantly improved or resolved with treatment of the systemic inflammatory joint disease.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010238> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010238> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010238> "2025-07-01T17:54:43Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010238> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010238> "ICOP number: 3.2.1.2")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010238> "temporomandibular joint pain attributed to systemic arthritis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010238> <http://purl.obolibrary.org/obo/PAIN_0010236>)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010238> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002410> <http://purl.obolibrary.org/obo/OHD_0010308>))

# Class: <http://purl.obolibrary.org/obo/PAIN_0010239> (temporomandibular joint pain attributed to disc displacement)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010239> "TMJ pain caused by TMJ disc displacement in the absence of TMJ arthritis. TMJ pain can here be due to mechanical derangements within the joint.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010239> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010239> <https://orcid.org/0009-0003-5583-4731>)
