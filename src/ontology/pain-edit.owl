AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010240> "temporomandibular joint pain attributed to disc displacement with reduction"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010240> <http://purl.obolibrary.org/obo/PAIN_0010239>)

