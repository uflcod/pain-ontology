# Class: <http://purl.obolibrary.org/obo/PAIN_0010275> (idiopathic orofacial pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010275> "Orofacial pain involving unilateral or bilateral intraoral or facial pain in the distribution(s) of one or more branches of the trigeminal nerve(s) for which the aetiology is unknown. The pain is usually persistent, of moderate intensity, poorly localized and described as dull, pressing or of burning character.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010275> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010275> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010275> "2025-07-07T17:31:21Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010275> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010275> "ICOP number: 6")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010275> "idiopathic orofacial pain"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/PAIN_0010275> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PAIN_0000090> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PAIN_0000127>)))

# Class: <http://purl.obolibrary.org/obo/PAIN_0010276> (burning mouth syndrome (BMS))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010276> "An intraoral burning or dysaesthetic sensation, recurring daily for more than 2 hours per day for more than 3 months, without evident causative lesions on clinical examination and investigation.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010276> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010276> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010276> "2025-07-07T17:32:34Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010276> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010276> "ICOP number: 6.1")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010276> "burning mouth syndrome (BMS)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010276> <http://purl.obolibrary.org/obo/PAIN_0010275>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010277> (burning mouth syndrome without somatosensory changes)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010277> "An intraoral burning or dysaesthetic sensation, recurring daily for more than 2 hours per day for more than 3 months, unaccompanied by somatosensory changes and without evident causative lesions on clinical examination and investigation.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010277> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010277> <https://orcid.org/0009-0003-5583-4731>)
