AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/OMO_0003011> "nasopharynx (UBERON:0001728) has the latin name \"pars nasalis pharyngis")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OMO_0003011> "A synonym type for describing Latin term synonyms.")
