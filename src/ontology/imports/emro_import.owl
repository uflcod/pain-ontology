AnnotationAssertion(rdfs:isDefinedBy <http://purl.bioontology.org/ontology/EMRO/0000005> <http://purl.obolibrary.org/obo/pain/imports/emro_import.owl>)
AnnotationAssertion(rdfs:label <http://purl.bioontology.org/ontology/EMRO/0000005> "sensory experience"@en)
