property_value: UBPROP:0000001 "Dermal bone that forms part of the upper jaw, located antero-ventral to the premaxilla. The maxilla is a paired bone.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000270", ontology="TAO", source="TAO:GA_TG"}
property_value: UBPROP:0000001 "Paired, intramembranous bone located on the lateral sides of the skull, posterior to the premaxillae.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000285", ontology="AAO", source="AAO:LAP"}
