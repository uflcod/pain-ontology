    <!-- http://purl.bioontology.org/ontology/PAIN/0000051 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000051">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <obo:IAO_0000115>Pain that is experienced in the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000589>abdominal pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T01:25:36Z</terms:created>
