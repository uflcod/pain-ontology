        <obo:IAO_0000119>https://www.frontiersin.org/journals/neurology/articles/10.3389/fneur.2023.1277654/full</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000002 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000002">
