            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Pain that is experienced as a diffuse, sustained, low-to-moderate intensity, dull, deep, pressure-like sensation that lacks sharp localization.</obo:IAO_0000115>
        <obo:IAO_0000589>aching pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T01:37:54Z</terms:created>
