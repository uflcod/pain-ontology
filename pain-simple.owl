        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>An intense, searing, or hot sensation quality.</obo:IAO_0000115>
        <obo:IAO_0000589>burning sensation quality (PAIN)</obo:IAO_0000589>
