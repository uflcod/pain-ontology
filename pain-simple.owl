        <rdfs:label xml:lang="en">decreased sensitivity to painful stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000006 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000006">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
