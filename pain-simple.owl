        <obo:IAO_0000115>Pain associated with temporomandibular disorders, affecting the masticatory muscles, the temporomandibular joint, or associated structures.</obo:IAO_0000115>
        <obo:IAO_0000589>temporomandibular disorder pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
