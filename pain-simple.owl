            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Pain that is experienced in an area where a limb no longer exists.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-13T21:23:11Z</terms:created>
        <rdfs:label xml:lang="en">phantom limb pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://id.nlm.nih.gov/mesh/D010591"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C79703"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OAE_0002792"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000830"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/710110008"/>
        <skos:closeMatch rdf:resource="http://www.ebi.ac.uk/efo/EFO_0022850"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000056 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000056">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <obo:IAO_0000115>Pain that is confined or restricted to a particular anatomical area (or zone) of the body.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-13T21:27:59Z</terms:created>
        <rdfs:label xml:lang="en">localized pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/112104007"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain that is confined or restricted to a particular anatomical area (or zone) of the body.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18077092</obo:IAO_0000119>
        <obo:IAO_0000119>https://ospinamedical.com/orthopedic-blog/localized-vs-radicular-pain-decoding-your-discomfort</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000057 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000057">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000094"/>
        <obo:IAO_0000115>knee pain resulting from knee osteoarthritis.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-13T21:33:51Z</terms:created>
        <rdfs:label xml:lang="en">knee osteoarthritis pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000058 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000058">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A rhythmic, pulsating, or beating sensation quality in which the intensity waxes and wanes in periodic bursts.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:06:15Z</terms:created>
        <rdfs:label xml:lang="en">throbbing sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/410704005"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000059 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000059">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A intense, searing, or hot sensation quality.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:06:31Z</terms:created>
        <rdfs:label xml:lang="en">burning sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/62404004"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000060 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000060">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000081"/>
        <obo:IAO_0000115>Pain that is experienced in the lower back.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-17T03:22:33Z</terms:created>
        <rdfs:label>lower back pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://id.nlm.nih.gov/mesh/D017116"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C34788"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000006"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000063 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000063">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000056"/>
        <obo:IAO_0000115>Pain that is experienced in the area proximal to an amputation site.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-28T16:45:26Z</terms:created>
        <oboInOwl:hasExactSynonym>residual limb pain</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">stump pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/247381009"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000064 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000064">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A sensation quality that characterizes a sensation as being intensely cold, typically accompanied by qualities of stillness, heaviness, numbness, and in extreme cases a paradoxical burning or painful character.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:06:51Z</terms:created>
        <rdfs:label xml:lang="en">freezing sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/84162001"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000066 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000066">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A sudden, intense, and sharp sensation quality.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:07:06Z</terms:created>
        <rdfs:label xml:lang="en">shooting sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/410705006"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000067 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000067">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A piercing, stabbling, cutting, or prickling sensation quality.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:08:02Z</terms:created>
        <rdfs:label xml:lang="en">sharp sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0025281"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/410707003"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000068 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000068">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A great or extreme sensation quality.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:08:30Z</terms:created>
        <rdfs:label xml:lang="en">intense sensation quality</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/ExO_0000065"/>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FBcv_0000169"/>
        <skos:relatedMatch rdf:resource="http://semanticscience.org/resource/SIO_001212"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A great or extreme sensation quality.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.merriam-webster.com/dictionary/intense</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000069 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000069">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A diffuse, sustained, low-to-moderate intensity, dull, deep, pressure-like sensation quality that lacks sharp localization.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:08:36Z</terms:created>
        <rdfs:label xml:lang="en">aching sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/410711009"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000070 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000070">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>An intense, sudden, and sharp sensation, often described as a knife-like or shooting, sensation quality that pierces a specific area.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:09:02Z</terms:created>
        <rdfs:label xml:lang="en">stabbing sensation quality</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/410706007"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000071 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000071">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Pain experienced as an intense, sudden, and sharp sensation, often described as a knife-like or shooting pain that pierces a specific body area.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:09:33Z</terms:created>
        <rdfs:label xml:lang="en">stabbing pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/55145008"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000072 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000072">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000067"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Pain that is experienced as piercing, stabbling, cutting, or prickling.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:09:47Z</terms:created>
        <rdfs:label xml:lang="en">sharp pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C101179"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/8708008"/>
    </owl:Class>
    


