        <skos:closeMatch>http://snomed.info/id/426206001</skos:closeMatch>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000102 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000102">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A constricting, gripping, or squeezing sensation quality. It is often associated with involuntary muscle contraction.</obo:IAO_0000115>
        <obo:IAO_0000589>cramping sensation quality (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T17:36:26Z</terms:created>
        <rdfs:label xml:lang="en">cramping sensation quality</rdfs:label>
        <skos:closeMatch>http://snomed.info/id/410709000</skos:closeMatch>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000103 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000103">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000036"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
