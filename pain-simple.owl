    <!-- http://purl.bioontology.org/ontology/PAIN/0000013 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000013">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000009"/>
        <dc:contributor>https://orcid.org/0000-0001-9625-1899</dc:contributor>
