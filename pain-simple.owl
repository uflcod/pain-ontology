        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000042"/>
        <obo:IAO_0000115>A sensation quality that characterizes a sensation as being intensely cold, typically accompanied by qualities of stillness, heaviness, numbness, and in extreme cases a paradoxical burning or painful character.</obo:IAO_0000115>
        <obo:IAO_0000589>freezing sensation quality (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:06:51Z</terms:created>
        <rdfs:label xml:lang="en">freezing sensation quality</rdfs:label>
        <skos:relatedMatch rdf:resource="http://snomed.info/id/84162001"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000065 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000065">
