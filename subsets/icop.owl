    <!-- http://purl.obolibrary.org/obo/UBERON_0001684 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002514"/>
