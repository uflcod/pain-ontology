     xml:base="http://purl.obolibrary.org/obo/pain/icop.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sssom="https://w3id.org/sssom/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/pain/icop.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/pain/releases/2026-09-25/icop.owl"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6378-1703"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-7246-1252"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0008-1739-5105"/>
        <terms:description>The International Classification of Orofacial Pain Ontology (ICOP) contains terms for defining and classifying Orofacial Pain types. The ICOP’s classes and relations facilitate the development of tools and resources capable of enhancing our understanding of orofacial pain. It is developed as a subset of the Oral Health and Disease Ontology (http://purl.obolibrary.org/obo/ohd.owl). Issues and new term requests can be submitted at https://github.com/oral-health-and-disease-ontologies/ohd-ontology/issues.

The ICOP ontology is based upon the International Classification of Orofacial Pain, 1st Edition (PMID: 32103673).</terms:description>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>International Classification of Orofacial Pain (ICOP)</terms:title>
        <owl:versionInfo>2026-09-25</owl:versionInfo>
    </owl:Ontology>
    


