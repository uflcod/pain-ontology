    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011825 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011821"/>
        <obo:IAO_0000115>Irregular connective tissue, the intercellular matrix of which contains a sparse irregular network of collagen and elastic fiber bundles. Examples: areolar tissue, neuroglial tissue, mucoid tissue.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:19783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33007</oboInOwl:hasDbXref>
