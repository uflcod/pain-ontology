        <oboInOwl:hasDbXref>SCTID:245775004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Periodontal_fiber</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fibra periodontalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>periodontal fiber</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>periodontal fibre</oboInOwl:hasExactSynonym>
