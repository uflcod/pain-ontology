        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0010230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Chronic highly frequent primary temporomandibular joint pain on temporomandibular joint palpation beyond the area of the joint.</obo:IAO_0000115>
