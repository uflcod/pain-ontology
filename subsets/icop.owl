        <rdfs:comment>ICOP number: 1.1.2.1.1.2</rdfs:comment>
        <rdfs:label xml:lang="en">postoperative periodontal pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010091 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010071"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0010090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Periodontal pain due to periodontits that is apical occuring becayse of an endodontic disease.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-19T19:11:03Z</terms:created>
