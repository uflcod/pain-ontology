        <rdfs:label xml:lang="en">chronic highly frequent primary temporomandibular joint pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010125"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0010229"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Chronic highly frequent primary temporomandibular joint pain on temporomandibular joint palpation localized to the immediate site of palpation.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-18T17:42:50Z</terms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 3.1.2.3.1</rdfs:comment>
        <rdfs:label xml:lang="en">chronic highly frequent primary temporomandibular joint pain without pain referral</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010127">
