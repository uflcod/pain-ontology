    <!-- http://purl.obolibrary.org/obo/UBERON_0034713 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000122"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
        <obo:IAO_0000115>Any of the cranial nerves, or their central nervous system analogs (the optic tract, the epiphyseal tract). These analogs are not true nerves, and are instead evaginated sensory afferents emanating from the brain.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasRelatedSynonym>cranial nerve fiber bundle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cranial nerve fiber tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cranial nerve or tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>neuron projection bundle from brain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0034713</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label>cranial neuron projection bundle</rdfs:label>
    </owl:Class>
