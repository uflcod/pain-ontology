                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>Pain that is experienced as a deep ache, pressure, or heaviness rather than a sharp, stabbing sensation.</obo:IAO_0000115>
        <obo:IAO_0000589>dull pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:09:53Z</terms:created>
