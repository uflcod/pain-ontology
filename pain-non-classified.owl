        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#upper_level"/>
        <rdfs:comment>Such a structure may contain some complete cells in addition to partial cells (e.g., glia in nervous system regions).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label>multi cell part structure</rdfs:label>
