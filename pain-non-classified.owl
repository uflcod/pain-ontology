        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0037303</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Skull</oboInOwl:source>
    </owl:Axiom>
    


