        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000122"/>
        <obo:IAO_0000115>An enclosed, cable-like bundle of axons in the peripheral nervous system originating in a nerve root in the central nervous system (or a condensed nervous structure) connecting with peripheral structures.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001>A portion of tissue which is a fasiculated group of axons.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000007>nervous</obo:UBPROP_0000007>
