        <oboInOwl:hasRelatedSynonym>breakthrough pain</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">episodic pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0032148"/>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C9203"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000038"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Acute transient pain that is severe and has an intensity that flares over baseline.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16675817</obo:IAO_0000119>
    </owl:Axiom>
    


