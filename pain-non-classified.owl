    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000075 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000075">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/PAIN/0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000064"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>Pain that is experienced as a burning or aching sensation and is the result of cold stimuli.</obo:IAO_0000115>
        <obo:IAO_0000589>freezing pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
