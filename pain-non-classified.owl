        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000404"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0019226"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic cellular unit of nervous tissue. Each neuron consists of a body, an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>BTO:0000938</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00005106</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:54527</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001483</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBbt:0003679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009248</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nerve cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>These cells are also reportedly CD4-negative and CD200-positive. They are also capable of producing CD40L and IFN-gamma.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label>neuron</rdfs:label>
        <skos:prefLabel>neuron</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.swissbiopics.org/api/image/Neuron_cells.svg</foaf:depiction>
    </owl:Class>
