        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>in FMA the skull is divided into orbit, neurocranium (8 parts), viscerocranium (26 parts). Here we have a separate overlapping division into cranium and mandible.</owl:annotatedTarget>
        <oboInOwl:external_ontology>FMA</oboInOwl:external_ontology>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003129"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000013"/>
        <owl:annotatedTarget>A skull that is missing a mandible is only a cranium; this is the source of a very commonly made error in terminology. Those animals having skulls are called craniates</owl:annotatedTarget>
        <oboInOwl:source>WP</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
