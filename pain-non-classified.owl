    <!-- http://purl.bioontology.org/ontology/PAIN/0000104 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000104">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/EMRO/0000005"/>
        <obo:IAO_0000115>An unpleasant abnormal sensory experience, whether spontaneous or evoked.</obo:IAO_0000115>
        <obo:IAO_0000589>dysesthesia (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T17:55:31Z</terms:created>
        <terms:description>An unpleasant abnormal sensation, whether spontaneous or evoked. Note: Compare with pain and with paresthesia. Special cases of dysesthesia include hyperalgesia and allodynia. A dysesthesia should always be unpleasant and a paresthesia should not be unpleasant, although it is recognized that the borderline may present some difficulties when it comes to deciding as to whether a sensation is pleasant or unpleasant. It should always be specified whether the sensations are spontaneous or evoked.
See entry in https://www.iasp-pain.org/resources/terminology.</terms:description>
        <rdfs:label xml:lang="en">dysesthesia</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C28246</skos:closeMatch>
        <skos:closeMatch>http://snomed.info/id/279079003</skos:closeMatch>
        <skos:relatedMatch>http://purl.obolibrary.org/obo/HP_0012534</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000104"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An unpleasant abnormal sensory experience, whether spontaneous or evoked.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/terminology</obo:IAO_0000119>
    </owl:Axiom>
    


