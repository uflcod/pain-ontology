        <oboInOwl:hasDbXref>MESH:D004550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:76248009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000340</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Elbow</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Elbow</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cubital region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>elbow limb segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>elbow region</oboInOwl:hasExactSynonym>
