    <!-- http://purl.bioontology.org/ontology/0000049 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/0000049">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/PAIN/0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000058"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>Pain that is experienced as a rhythmic, pulsating, or beating sensation in which the pain&apos;s intensity waxes and wanes in periodic bursts. Throbbing pain is typically synchronized with the cardiac cycle.</obo:IAO_0000115>
        <obo:IAO_0000589>throbbing pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-08T19:58:42Z</terms:created>
        <rdfs:label xml:lang="en">throbbing pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/29695002"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/0000050 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/0000050">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000040"/>
        <obo:IAO_0000115>Chronic pain that frequently limits life or work activities.</obo:IAO_0000115>
        <obo:IAO_0000115>Chronic pain that significantly impacts a person&apos;s ability to function.</obo:IAO_0000115>
        <obo:IAO_0000589>chronic high impact (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-01T20:50:40Z</terms:created>
        <rdfs:label xml:lang="en">chronic high impact pain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/0000050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Chronic pain that frequently limits life or work activities.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.iasp-pain.org/resources/fact-sheets/high-impact-chronic-pain/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/EMRO/0000000 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/EMRO/0000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007610"/>
        <obo:IAO_0000115>A behavioral response that includes overt action, cognitive response, verbal response, or physiological reaction in response to a situation or event, or internal process which evokes positive feelings, negative feelings, or surprise (i.e., emotional experiences).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0766-8455"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-11-24T20:50:19Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.bioontology.org/ontology/emro.owl"/>
        <rdfs:label xml:lang="en">emotion process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/EMRO/0000001 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/EMRO/0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050890"/>
        <obo:IAO_0000115>A cognitive process during which an organism is aware of something either internal or external to itself.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0766-8455"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-11-24T20:52:17Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.bioontology.org/ontology/emro.owl"/>
        <rdfs:label xml:lang="en">phenomenal cognitive experience</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.bioontology.org/ontology/EMRO/0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cognitive process during which an organism is aware of something either internal or external to itself.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/consciousness</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/EMRO/0000002 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/EMRO/0000002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/EMRO/0000001"/>
                    <owl:Restriction>
