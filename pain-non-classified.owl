        <skos:closeMatch rdf:resource="http://snomed.info/id/8708008"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000073 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000073">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/PAIN/0000036"/>
