        <oboInOwl:id>GO:0048265</oboInOwl:id>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <rdfs:label>response to pain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048265"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a pain stimulus. Pain stimuli cause activation of nociceptors, peripheral receptors for pain, include receptors which are sensitive to painful mechanical stimuli, extreme heat or cold, and chemical stimuli.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:10203867</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12723742</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12843304</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pain</oboInOwl:hasDbXref>
    </owl:Axiom>
    


