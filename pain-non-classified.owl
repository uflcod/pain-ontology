    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000475"/>
        <obo:IAO_0000115>The lower segment of the trunk, inferioposterior to the abdomen proper, in the transition area between the trunk and the lower limbs.</obo:IAO_0000115>
        <obo:UBPROP_0000007>pelvic</obo:UBPROP_0000007>
        <obo:UBPROP_0000012>MA and FMA differ in what they consider to be parts of the pelvis. MA includes ureter, urethra, urinary bladder, reproductive organs</obo:UBPROP_0000012>
