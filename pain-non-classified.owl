    </owl:Axiom>
    


    <!-- http://purl.bioontology.org/ontology/PAIN/0000074 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/PAIN/0000074">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.bioontology.org/ontology/PAIN/0000036"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.bioontology.org/ontology/PAIN/0000059"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>Pain that is experienced as an intense, searing, or hot sensation.</obo:IAO_0000115>
        <obo:IAO_0000589>burning pain (PAIN)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-12T17:10:00Z</terms:created>
