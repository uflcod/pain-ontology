        <owl:annotatedTarget>The area that extends from the median ocellus to the oral foramen[HAO].</owl:annotatedTarget>
        <oboInOwl:source>HAO:0000316</oboInOwl:source>
        <oboInOwl:source>http://api.hymao.org/api/ref/67791</oboInOwl:source>
        <oboInOwl:taxon>NCBITaxon:7399</oboInOwl:taxon>
